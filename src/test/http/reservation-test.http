# IntelliJ HTTP Client 수동 검증 모음. 개발/테스트 DB에서 기본 흐름 1~12를 순서대로 실행한다.
# IDE에 전달할 환경변수:
# HAIR_TEST_MEMBER_ID, HAIR_TEST_PASSWORD: 예약을 만들 테스트 계정
# HAIR_TEST_DESIGNER_ID, HAIR_TEST_SERVICE_ID: 같은 살롱에 속한 실제 디자이너/시술 ID
# HAIR_TEST_TOTAL_PRICE: 선택한 시술의 결제 금액(0 이상의 정수)
# 실제 계정/비밀번호는 파일에 적지 않는다. Basic 인증은 지원하지 않으며 폼 로그인과 세션 쿠키를 사용한다.
# HTTP Client의 기본 쿠키 저장소를 사용한다. 로그인 후에는 새 CSRF 토큰을 다시 받아야 한다.
# 취소는 행 삭제가 아니라 CANCELLED 변경이다. 기본 흐름은 이번에 생성한 예약만 변경·취소한다.

@baseUrl = http://localhost:8080
@memberId = {{$env.HAIR_TEST_MEMBER_ID}}
@designerId = {{$env.HAIR_TEST_DESIGNER_ID}}
@salonServiceId = {{$env.HAIR_TEST_SERVICE_ID}}
@totalPrice = {{$env.HAIR_TEST_TOTAL_PRICE}}
@reservationTime = 14:00:00
@updatedTime = 15:00:00

### 1. 로그인 전 CSRF 토큰 (기존 로그인 시 마이페이지로 이동해도 추출 가능)
GET {{baseUrl}}/members/login

> {%
    client.global.clear("createdReservationId");
    client.global.clear("reservationCsrf");
    const csrf = String(response.body).match(/<input\b[^>]*\bname="_csrf"[^>]*\bvalue="([^"]+)"/);
    client.assert(response.status === 200 && csrf, "로그인 폼의 CSRF 토큰이 필요합니다.");
    client.global.set("reservationCsrf", csrf[1]);
%}

### 2. 테스트 회원 로그인 (비밀번호에 &, + 등이 있어도 폼 인코딩)
# @no-log
# @no-redirect
# @no-auto-encoding
< {%
    client.assert($env.HAIR_TEST_MEMBER_ID && $env.HAIR_TEST_PASSWORD, "테스트 계정 환경변수를 설정하세요.");
    request.variables.set("loginMemberId", encodeURIComponent($env.HAIR_TEST_MEMBER_ID));
    request.variables.set("loginPassword", encodeURIComponent($env.HAIR_TEST_PASSWORD));
%}
POST {{baseUrl}}/members/login
Content-Type: application/x-www-form-urlencoded

memberId={{loginMemberId}}&password={{loginPassword}}&_csrf={{reservationCsrf}}

> {%
    const location = response.headers.valueOf("Location") || "";
    client.assert(response.status === 302 && !location.includes("error=true"), "로그인 실패: 계정과 비밀번호를 확인하세요.");
    client.global.clear("reservationCsrf");
%}

### 3. 로그인 후 CSRF 재발급 및 다음 주 예약 날짜 준비
# @no-redirect
GET {{baseUrl}}/members/me

> {%
    const csrf = String(response.body).match(/<input\b[^>]*\bname="_csrf"[^>]*\bvalue="([^"]+)"/);
    client.assert(response.status === 200 && csrf, "로그인 세션과 새 CSRF 토큰이 필요합니다.");
    client.global.set("reservationCsrf", csrf[1]);
    const date = new Date();
    date.setDate(date.getDate() + 7);
    client.global.set("reservationDate", `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`);
%}

### 4. 예약 가능 시간 확인 (available=false이면 위 시간을 바꾸고 다시 확인)
GET {{baseUrl}}/api/reservations/availability?designerId={{designerId}}&reservationDate={{reservationDate}}&reservationTime={{reservationTime}}
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.available === true, "이미 예약된 시간입니다. 다른 시간을 선택하세요.");
%}

### 5. 예약 생성 (memberId는 필수 입력이며 실제 소유자는 로그인 계정으로 결정됨)
POST {{baseUrl}}/api/reservations
Content-Type: application/json
X-CSRF-TOKEN: {{reservationCsrf}}

{
  "memberId": "{{memberId}}",
  "designerId": {{designerId}},
  "salonServiceId": {{salonServiceId}},
  "reservationDate": "{{reservationDate}}",
  "reservationTime": "{{reservationTime}}",
  "totalPrice": {{totalPrice}},
  "paymentMethod": "CARD"
}

> {%
    client.assert(response.status === 200 && Number.isInteger(response.body.reservationId), "예약 생성이 실패했습니다.");
    client.assert(response.body.memberId === $env.HAIR_TEST_MEMBER_ID && response.body.status === "RESERVED", "예약 소유자 또는 상태가 일치하지 않습니다.");
    client.global.set("createdReservationId", response.body.reservationId);
%}

### 6. 이번에 만든 예약 1건 조회 (본인 또는 ADMIN만 가능)
GET {{baseUrl}}/api/reservations/{{createdReservationId}}
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.reservationId === Number(client.global.get("createdReservationId")), "생성한 예약을 조회하지 못했습니다.");
%}

### 7. 로그인 회원의 예약 목록
GET {{baseUrl}}/api/reservations/my
Accept: application/json

> {%
    client.assert(response.status === 200 && Array.isArray(response.body), "본인 예약 목록 조회가 실패했습니다.");
    client.assert(response.body.every(item => item.memberId === $env.HAIR_TEST_MEMBER_ID), "다른 계정의 예약이 반환되었습니다.");
%}

### 8. 회원 ID로 예약 목록 조회 (본인 또는 ADMIN만 가능)
GET {{baseUrl}}/api/reservations/member/{{memberId}}
Accept: application/json

> {%
    client.assert(response.status === 200 && Array.isArray(response.body), "회원 예약 목록 조회가 실패했습니다.");
%}

### 9. 변경할 시간 확인 (자기 예약은 충돌 검사에서 제외)
GET {{baseUrl}}/api/reservations/availability?designerId={{designerId}}&reservationDate={{reservationDate}}&reservationTime={{updatedTime}}&reservationId={{createdReservationId}}
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.available === true, "변경 시간이 이미 예약되어 있습니다.");
%}

### 10. RESERVED 예약 변경 (결제 수단: CARD, CASH, KAKAO_PAY, NAVER_PAY)
PUT {{baseUrl}}/api/reservations/{{createdReservationId}}
Content-Type: application/json
X-CSRF-TOKEN: {{reservationCsrf}}

{
  "designerId": {{designerId}},
  "salonServiceId": {{salonServiceId}},
  "reservationDate": "{{reservationDate}}",
  "reservationTime": "{{updatedTime}}",
  "totalPrice": {{totalPrice}},
  "paymentMethod": "CARD"
}

> {%
    client.assert(response.status === 200 && response.body.reservationTime === client.variables.file.get("updatedTime"), "예약 변경 결과가 일치하지 않습니다.");
%}

### 11. 이번에 만든 예약 취소 (COMPLETED/CANCELLED 예약은 취소 불가)
DELETE {{baseUrl}}/api/reservations/{{createdReservationId}}
X-CSRF-TOKEN: {{reservationCsrf}}

> {%
    client.assert(response.status === 200, "예약 취소가 실패했습니다.");
%}

### 12. 취소 상태 확인 (예약 행은 유지됨)
GET {{baseUrl}}/api/reservations/{{createdReservationId}}
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.status === "CANCELLED", "취소 상태가 반영되지 않았습니다.");
%}

### A1. 전체 예약 조회 (선택: ADMIN 전용, 기본 흐름과 별도로 실행)
# ADMIN 계정으로 HAIR_TEST_MEMBER_ID, HAIR_TEST_PASSWORD를 설정하고 1~3을 재실행한 뒤 사용한다.
# 별도 HAIR_TEST_ADMIN_RESERVATION_ID에는 상태를 바꿔도 되는 RESERVED 테스트 예약을 지정한다.
# 기본 흐름에서 이미 취소한 예약을 재사용하지 않는다. 이 구간은 기본 흐름과 별도로 실행한다.
# COMPLETED로 바꿔도 미래 예약의 리뷰 작성은 불가하다. 예약 시각도 지나야 한다.

GET {{baseUrl}}/api/reservations
Accept: application/json

> {%
    client.assert(response.status === 200 && Array.isArray(response.body), "ADMIN 권한이 필요합니다.");
%}

### A2. 별도로 지정한 RESERVED 테스트 예약의 방문 완료 처리 (ADMIN 전용)
PATCH {{baseUrl}}/api/reservations/{{$env.HAIR_TEST_ADMIN_RESERVATION_ID}}/status
Content-Type: application/json
X-CSRF-TOKEN: {{reservationCsrf}}

{
  "status": "COMPLETED"
}

> {%
    client.assert(response.status === 200 && response.body.status === "COMPLETED", "ADMIN 권한과 대상 예약의 RESERVED 상태를 확인하세요.");
%}

# IntelliJ HTTP Client 수동 검증 모음. 개발/테스트 DB에서 1~15를 순서대로 실행한다.
# IDE에 전달할 환경변수:
# HAIR_TEST_MEMBER_ID, HAIR_TEST_PASSWORD: 리뷰를 작성할 테스트 계정
# HAIR_TEST_REVIEW_RESERVATION_ID: 해당 계정의 별도 테스트 예약 ID
# 예약 조건: 예약 날짜·시각이 이미 지났고 CANCELLED가 아니며 기존 리뷰가 없어야 한다.
# COMPLETED 상태만으로 미래 예약의 리뷰를 작성할 수는 없다. 관리자도 타인 예약에 리뷰를 만들 수 없다.
# 실제 계정/비밀번호를 파일에 적지 않는다. 기본 HTTP Client 쿠키 저장소로 세션을 유지한다.
# 이 흐름에서 만든 리뷰 ID만 수정·삭제에 사용한다. 마지막 삭제는 이번 리뷰와 관련 데이터를 삭제한다.

@baseUrl = http://localhost:8080
@memberId = {{$env.HAIR_TEST_MEMBER_ID}}

### 1. 로그인 전 CSRF 토큰 (기존 로그인 시 마이페이지로 이동해도 추출 가능)
GET {{baseUrl}}/members/login

> {%
    client.global.clear("createdReviewId");
    client.global.clear("reviewReservationId");
    client.global.clear("reviewDesignerId");
    client.global.clear("reviewCsrf");
    const csrf = String(response.body).match(/<input\b[^>]*\bname="_csrf"[^>]*\bvalue="([^"]+)"/);
    client.assert(response.status === 200 && csrf, "로그인 폼의 CSRF 토큰이 필요합니다.");
    client.global.set("reviewCsrf", csrf[1]);
%}

### 2. 예약 소유자 로그인
# @no-log
# @no-redirect
# @no-auto-encoding
< {%
    client.assert($env.HAIR_TEST_MEMBER_ID && $env.HAIR_TEST_PASSWORD, "테스트 계정 환경변수를 설정하세요.");
    request.variables.set("loginMemberId", encodeURIComponent($env.HAIR_TEST_MEMBER_ID));
    request.variables.set("loginPassword", encodeURIComponent($env.HAIR_TEST_PASSWORD));
%}
POST {{baseUrl}}/members/login
Content-Type: application/x-www-form-urlencoded

memberId={{loginMemberId}}&password={{loginPassword}}&_csrf={{reviewCsrf}}

> {%
    const location = response.headers.valueOf("Location") || "";
    client.assert(response.status === 302 && !location.includes("error=true"), "로그인 실패: 계정과 비밀번호를 확인하세요.");
    client.global.clear("reviewCsrf");
%}

### 3. 로그인 후 CSRF 토큰 재발급
# @no-redirect
GET {{baseUrl}}/members/me

> {%
    const csrf = String(response.body).match(/<input\b[^>]*\bname="_csrf"[^>]*\bvalue="([^"]+)"/);
    client.assert(response.status === 200 && csrf, "로그인 세션과 새 CSRF 토큰이 필요합니다.");
    client.global.set("reviewCsrf", csrf[1]);
%}

### 4. 지정한 테스트 예약의 소유자·방문 시각 확인
GET {{baseUrl}}/api/reservations/{{$env.HAIR_TEST_REVIEW_RESERVATION_ID}}
Accept: application/json

> {%
    client.assert(response.status === 200, "리뷰용 테스트 예약 조회가 실패했습니다.");
    const reservation = response.body;
    client.assert(reservation.memberId === $env.HAIR_TEST_MEMBER_ID, "로그인 계정 본인의 예약을 지정하세요.");
    client.assert(reservation.status !== "CANCELLED", "취소된 예약에는 리뷰를 작성할 수 없습니다.");
    // 서버에서 판단하는 조건이며, 이 날짜·시각은 서버와 같은 시간대를 기준으로 확인한다.
    client.assert(new Date(`${reservation.reservationDate}T${reservation.reservationTime}`) <= new Date(), "예약 시각이 지난 테스트 예약을 지정하세요. 서버와 IDE의 시간대도 확인하세요.");
    client.global.set("reviewReservationId", reservation.reservationId);
    client.global.set("reviewDesignerId", reservation.designerId);
%}

### 5. 본인 리뷰 목록 및 예약당 1개 제한 사전 확인
GET {{baseUrl}}/api/reviews/member/{{memberId}}
Accept: application/json

> {%
    client.assert(response.status === 200 && Array.isArray(response.body), "본인 리뷰 목록 조회가 실패했습니다.");
    client.assert(response.body.every(review => review.reservationId !== Number(client.global.get("reviewReservationId"))), "이미 리뷰가 있는 예약입니다. 별도의 테스트 예약을 지정하세요.");
%}

### 6. 리뷰 작성 (1~5점, 내용 필수; 회원·디자이너는 예약에서 결정)
POST {{baseUrl}}/api/reviews
Content-Type: application/json
X-CSRF-TOKEN: {{reviewCsrf}}

{
  "reservationId": {{reviewReservationId}},
  "rating": 5,
  "content": "요청한 스타일과 손질 방법을 자세히 안내해 주셨습니다."
}

> {%
    client.assert(response.status === 200 && Number.isInteger(response.body.reviewId), "리뷰 작성이 실패했습니다.");
    client.assert(response.body.reservationId === Number(client.global.get("reviewReservationId")), "예약 연결이 일치하지 않습니다.");
    client.global.set("createdReviewId", response.body.reviewId);
%}

### 7. 리뷰 목록 (sortBy: latest, rating, likes; designerId는 선택)
GET {{baseUrl}}/api/reviews?designerId={{reviewDesignerId}}&sortBy=latest
Accept: application/json

> {%
    client.assert(response.status === 200 && Array.isArray(response.body), "리뷰 목록 조회가 실패했습니다.");
    client.assert(response.body.some(review => review.reviewId === Number(client.global.get("createdReviewId"))), "생성한 리뷰가 목록에 없습니다.");
%}

### 8. 생성한 리뷰 1건 조회
GET {{baseUrl}}/api/reviews/{{createdReviewId}}
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.reviewId === Number(client.global.get("createdReviewId")), "생성한 리뷰 조회가 실패했습니다.");
%}

### 9. 리뷰 상세 (이미지 목록·답글 포함)
GET {{baseUrl}}/api/reviews/{{createdReviewId}}/detail
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.reviewId === Number(client.global.get("createdReviewId")), "리뷰 상세 조회가 실패했습니다.");
%}

### 10. 이번에 만든 리뷰 수정 (작성자 또는 ADMIN만 가능)
PUT {{baseUrl}}/api/reviews/{{createdReviewId}}
Content-Type: application/json
X-CSRF-TOKEN: {{reviewCsrf}}

{
  "rating": 4,
  "content": "스타일이 마음에 들며 안내받은 방법으로 편하게 손질하고 있습니다."
}

> {%
    client.assert(response.status === 200 && response.body.rating === 4, "리뷰 수정이 실패했습니다.");
%}

### 11. 저장된 수정 결과 확인
GET {{baseUrl}}/api/reviews/{{createdReviewId}}
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.rating === 4 && response.body.content.includes("편하게 손질"), "수정 내용이 저장되지 않았습니다.");
%}

### 12. 디자이너 평균 평점
GET {{baseUrl}}/api/reviews/designer/{{reviewDesignerId}}/average-rating
Accept: application/json

> {%
    client.assert(response.status === 200 && typeof response.body === "number", "평균 평점 조회가 실패했습니다.");
%}

### 13. 디자이너 TOP 3 (실제 API는 /designer/top3)
GET {{baseUrl}}/api/reviews/designer/top3
Accept: application/json

> {%
    client.assert(response.status === 200 && Array.isArray(response.body) && response.body.length <= 3, "디자이너 순위 조회가 실패했습니다.");
%}

### 14. 이번에 만든 리뷰 삭제 (작성자 또는 ADMIN만 가능)
DELETE {{baseUrl}}/api/reviews/{{createdReviewId}}
X-CSRF-TOKEN: {{reviewCsrf}}

> {%
    client.assert(response.status === 200, "리뷰 삭제가 실패했습니다.");
%}

### 15. 삭제 결과 확인 (목록에서 제거되었는지 검증)
GET {{baseUrl}}/api/reviews/member/{{memberId}}
Accept: application/json

> {%
    client.assert(response.status === 200 && Array.isArray(response.body), "삭제 후 리뷰 목록 조회가 실패했습니다.");
    client.assert(response.body.every(review => review.reviewId !== Number(client.global.get("createdReviewId"))), "삭제한 리뷰가 남아 있습니다.");
    client.global.clear("createdReviewId");
    client.global.clear("reviewReservationId");
    client.global.clear("reviewDesignerId");
%}
